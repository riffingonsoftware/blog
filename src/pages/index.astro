---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getVisiblePosts } from "../lib/postFilters";
import { postPath } from "../lib/slug";
const last_posts = (await getVisiblePosts()).slice(0, 3);
---

<DefaultLayout>
  <div>
    <div class="text-5xl font-bold">Welcome, Wanderer</div>
    <p>
      Welcome to a discordant group of ramblings on whatever happens to be on my mind, but mostly software. Maybe, just
      maybe, the noise might be kindly thought of as riffing.
      <br />
      <br />
      Why should you listen to me? You shouldn't. I'm probably wrong.
    </p>
  </div>
  <div class="mt-10">
    <div class="mt-10 mb-5 w-full text-3xl font-bold">Latest Posts</div>
    {last_posts.map((post) => {
      return (
        <div>
          <HorizontalCard
            pubDate={post.data.pubDate}
            title={post.data.title}
            img={post.data.heroImage}
            imgAlt={post.data.heroImageAlt}
            desc={post.data.description}
            url={postPath(post.id)}
            tags={post.data.tags}
            target="_self"
          />
          <div class="divider my-0" />
        </div>
      );
    })}
  </div>
</DefaultLayout>
