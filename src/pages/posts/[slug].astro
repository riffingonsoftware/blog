---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { PostSchema } from "../../content/posts/config";
import PostLayout from "../../layouts/PostLayout.astro";
import { readingTime } from "../../lib/readingTime";
import { excerptFromMarkdown } from "../../lib/excerpt";
import { includeVisiblePosts } from "../../lib/postFilters";
import { getSlug } from "../../lib/slug";

export async function getStaticPaths() {
  const postEntries = await getCollection("posts", includeVisiblePosts);
  return postEntries.map((entry) => {
    return {
      params: { slug: getSlug(entry.slug) },
      props: { entry },
    };
  });
}

export interface Props {
  entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const post: PostSchema = entry.data;
const { Content } = await entry.render();
let rt: string | undefined;
// Compute reading time from raw markdown/body if available
if ("body" in entry && typeof entry.body === "string") {
  rt = readingTime(entry.body);
}
const ogImage = `/og/${getSlug(entry.slug)}.jpg`;
// Use frontmatter description if present; fallback to content excerpt
let description = post.description;
if (!description) {
  if ("body" in entry && typeof entry.body === "string") {
    const ex = excerptFromMarkdown(entry.body, 160);
    if (ex && ex.length > 0) description = ex;
  }
}
---

<PostLayout
  author={post.author}
  pubDate={post.pubDate}
  title={post.title}
  heroImage={post.heroImage}
  heroImageAlt={post.heroImageAlt}
  description={description}
  updatedDate={post.updatedDate}
  tags={post.tags}
  canonicalUrl={post.canonicalUrl}
  readingTime={rt}
  ogImage={ogImage}
  slug={entry.slug}
>
  <Content />
</PostLayout>
