---
import { CollectionEntry, getCollection } from "astro:content";
import type { PostSchema } from "../../content/posts/config";
import PostLayout from "../../layouts/PostLayout.astro";
import { readingTime } from "../../lib/readingTime";
import { excerptFromMarkdown } from "../../lib/excerpt";

export async function getStaticPaths() {
  const postEntries = await getCollection("posts", ({ data }) => {
    return data.draft !== true;
  });
  return postEntries.map((entry) => {
    const slugLast = entry.slug.split("/").pop() || entry.slug;
    return {
      params: { slug: slugLast },
      props: { entry },
    };
  });
}

export interface Props {
  entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const post: PostSchema = entry.data;
const { Content } = await entry.render();
let rt: string | undefined;
// Compute reading time from raw markdown/body if available
if ("body" in entry && typeof entry.body === "string") {
  rt = readingTime(entry.body);
}
const slugLast = entry.slug.split("/").pop() || entry.slug;
const ogImage = `/og/${slugLast}.jpg`;
// Ensure LinkedIn-friendly description length; fallback to content excerpt
let description = post.description;
if (!description || description.length < 100) {
  if ("body" in entry && typeof entry.body === "string") {
    const ex = excerptFromMarkdown(entry.body, 160);
    if (ex && ex.length > 0) description = ex;
  }
}
---

<PostLayout
  author={post.author}
  pubDate={post.pubDate}
  title={post.title}
  heroImage={post.heroImage}
  heroImageAlt={post.heroImageAlt}
  description={description}
  updatedDate={post.updatedDate}
  tags={post.tags}
  canonicalUrl={post.canonicalUrl}
  readingTime={rt}
  ogImage={ogImage}
  slug={entry.slug}
>
  <Content />
</PostLayout>
