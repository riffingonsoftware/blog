---
import { SITE_TITLE } from "../config";
---

<header id="site-header" class="navbar bg-page/90 sticky top-0 z-30 shadow-sm backdrop-blur md:hidden">
  <div class="navbar-start">
    <button
      id="menu-button"
      aria-label="Open menu"
      aria-controls="sidebar-panel"
      aria-expanded="false"
      class="btn btn-ghost btn-square"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"
        ><path
          fill-rule="evenodd"
          d="M3.75 5.25A.75.75 0 0 1 4.5 4.5h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 7.5a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm.75 6.75a.75.75 0 0 0 0 1.5h15a.75.75 0 0 0 0-1.5h-15Z"
          clip-rule="evenodd"></path></svg
      >
    </button>
  </div>
  <div class="navbar-center">
    <a href="/" class="btn btn-ghost text-xl normal-case">{SITE_TITLE}</a>
  </div>
  <div class="navbar-end"></div>

  <script is:inline>
    (function () {
      if (window.__sidebarHeaderInitialized) return;
      window.__sidebarHeaderInitialized = true;

      function onClick(e) {
        const target = e?.target?.closest?.("#menu-button");
        if (target) {
          window.dispatchEvent(new CustomEvent("toggleSidebar"));
        }
      }

      function onSidebarToggled(e) {
        const btn = document.getElementById("menu-button");
        const open = e?.detail?.open;
        if (btn && typeof open === "boolean") {
          btn.setAttribute("aria-expanded", String(open));
        }
      }

      // Event delegation ensures clicks work across client navigations
      document.addEventListener("click", onClick);
      // Update aria-expanded on the current button each time
      window.addEventListener("sidebarToggled", onSidebarToggled);
    })();
    // @ts-ignore
    window.__sidebarHeaderInitialized = window.__sidebarHeaderInitialized || false;
  </script>
</header>
