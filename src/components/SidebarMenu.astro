---
const { sideBarActiveItemID } = Astro.props;
---

<ul class="menu menu-vertical flex-grow overflow-y-auto px-2">
  <li>
    <a
      id="home"
      href="/"
      class="rounded-lg hover:bg-white/10"
      aria-current={sideBarActiveItemID === "home" ? "page" : undefined}>Home</a
    >
  </li>
  <li>
    <a
      id="posts"
      href="/posts/"
      class="rounded-lg hover:bg-white/10"
      aria-current={sideBarActiveItemID === "posts" ? "page" : undefined}>Posts</a
    >
  </li>
</ul>
