---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
  author?: string;
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  canonicalUrl?: string;
  isArticle?: boolean;
  updatedDate?: Date;
  tags?: string[];
}

const {
  author,
  title,
  description,
  image,
  pubDate,
  canonicalUrl,
  isArticle = false,
  updatedDate,
  tags = [],
} = Astro.props;
const pubIso = pubDate?.toISOString();
const updIso = updatedDate?.toISOString();
const pageUrl = canonicalUrl ?? Astro.url;
const ogImageAbs = new URL(image || "/og/default.jpg", Astro.url).toString();
---

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Riffing on Software" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>{title}</title>

  {/* Canonical URL */}
  <link rel="canonical" href={pageUrl} />

  {/* Open Graph */}
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content="Riffing on Software" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:secure_url" content={ogImageAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="627" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content={title} />
  {isArticle && author && <meta property="article:author" content={author} />}
  {isArticle && pubIso && <meta property="article:published_time" content={pubIso} />}
  {isArticle && updIso && <meta property="article:modified_time" content={updIso} />}
  {isArticle && tags.map((t) => <meta property="article:tag" content={t} />)}

  {/* Twitter Cards */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <meta name="twitter:site" content="@riffingonsw" />
  <meta name="twitter:creator" content="@riffingonsw" />
  <ClientRouter />
</head>
