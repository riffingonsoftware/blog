---
import "../styles/global.css";
import { ViewTransitions } from 'astro:transitions';

export interface Props {
  author?: string;
  title: string;
  description: string;
  image?: string;
  pubDate?: string;
}

const { author, title, description, image, pubDate } = Astro.props as Props;
---

<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta charset="utf-8" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="title" content={title} />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>{title}</title>

  <!-- Canonical URL -->
  <link rel="canonical" href={Astro.url} />

  <!-- Open Graph -->
  <meta property="og:author" content={author || "Ricardo Torres"} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image || '/images/riffingonsoftware-og.webp', Astro.url)} />
  {pubDate && <meta property="og:publish_date" content={pubDate} />}

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image || '/images/riffingonsoftware-og.webp', Astro.url)} />
  <meta name="twitter:url" content={Astro.url} />
  <meta name="twitter:site" content="@riffingonsw" />
  <meta name="twitter:creator" content="@riffingonsw" />
  <ViewTransitions />
</head>
