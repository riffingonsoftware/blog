---
import { Image } from "astro:assets";
import profileImage from "../images/profile.png";
import SidebarFooter from "./SidebarFooter.astro";
import SidebarMenu from "./SidebarMenu.astro";
---

<div class="pointer-events-none fixed inset-y-0 left-0 z-40 md:pointer-events-auto md:relative" id="sidebar">
  \
  <!-- Hidden overlay for mobile - shown when sidebar is open -->
  <div class="fixed inset-0 z-10 hidden bg-black/50 transition-opacity md:hidden" id="sidebar-overlay"></div>

  <aside
    class="bg-sidebar relative z-20 flex hidden h-screen w-[15rem] flex-col px-2 pt-2 text-white md:sticky md:top-0 md:flex"
    id="sidebar-panel"
  >
    <div class="mx-auto mt-5 mb-6 w-fit">
      <a href="/">
        <div class="m-auto block transition ease-in-out hover:scale-[102%]">
          <div class="h-[8.5rem] w-[8.5rem] overflow-hidden rounded-full">
            <Image
              class="h-full w-full object-cover"
              format="webp"
              width={300}
              height={300}
              src={profileImage}
              alt="Portrait of Ricardo Torres"
            />
          </div>
        </div>
      </a>
    </div>

    <nav aria-label="Primary">
      <SidebarMenu sideBarActiveItemID="home" />
    </nav>

    <div class="mt-auto px-0 pt-6">
      <SidebarFooter />
    </div>
  </aside>
</div>

<script is:inline>
  const overlay = document.getElementById("sidebar-overlay");
  const panel = document.getElementById("sidebar-panel");
  const sidebar = document.getElementById("sidebar");
  const headerEl = document.getElementById("site-header");
  const contentEl = document.getElementById("page-content");
  let previouslyFocused = null;

  function getFocusable(root) {
    if (!root) return [];
    const selectors = ["a[href]", "button", "textarea", "input", "select", '[tabindex]:not([tabindex="-1"])'].join(",");
    return Array.from(root.querySelectorAll(selectors)).filter(
      (el) => !el.hasAttribute("disabled") && !el.getAttribute("aria-hidden") && el.offsetParent !== null,
    );
  }

  function toggle() {
    if (!overlay || !panel) return;
    const showing = !panel.classList.contains("hidden");
    if (showing) {
      panel.classList.add("hidden");
      overlay.classList.add("hidden");
    } else {
      panel.classList.remove("hidden");
      overlay.classList.remove("hidden");
    }
    const open = !panel.classList.contains("hidden");

    // Ensure wrapper doesn't intercept taps when closed on mobile
    if (open) {
      sidebar?.classList.remove("pointer-events-none");
    } else {
      sidebar?.classList.add("pointer-events-none");
    }

    // Modal semantics only when open on mobile
    if (open) {
      previouslyFocused = document.activeElement;
      panel.setAttribute("role", "dialog");
      panel.setAttribute("aria-modal", "true");
      panel.setAttribute("aria-label", "Navigation");
      // Move focus into panel
      const f = getFocusable(panel);
      f[0]?.focus();
      // Trap focus inside
      const trap = (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          toggle();
          return;
        }
        if (e.key !== "Tab") return;
        const focusables = getFocusable(panel);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      };
      panel.addEventListener("keydown", trap);
      panel._trapHandler = trap;
      // Inert background and prevent scroll
      headerEl?.setAttribute("inert", "");
      contentEl?.setAttribute("inert", "");
      document.body.style.overflow = "hidden";
    } else {
      panel.removeAttribute("role");
      panel.removeAttribute("aria-modal");
      panel.removeAttribute("aria-label");
      if (panel._trapHandler) {
        panel.removeEventListener("keydown", panel._trapHandler);
        panel._trapHandler = null;
      }
      headerEl?.removeAttribute("inert");
      contentEl?.removeAttribute("inert");
      document.body.style.overflow = "";
      // Return focus to the toggle button if possible
      if (previouslyFocused && previouslyFocused.focus) {
        try {
          previouslyFocused.focus();
        } catch {}
      }
    }
    window.dispatchEvent(new CustomEvent("sidebarToggled", { detail: { open } }));
  }
  overlay?.addEventListener("click", toggle);
  window.addEventListener("toggleSidebar", toggle);
</script>
