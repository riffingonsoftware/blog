---
import { Image } from "astro:assets";
import profileImage from "../images/profile.png";
import SidebarFooter from "./SidebarFooter.astro";
import SidebarMenu from "./SidebarMenu.astro";

// Determine active sidebar item from current path
const { pathname } = Astro.url;
const computedActiveId = pathname.startsWith("/posts") ? "posts" : pathname === "/" ? "home" : undefined;
---

<div class="pointer-events-none fixed inset-y-0 left-0 z-40 md:pointer-events-auto md:relative" id="sidebar">
  <!-- Hidden overlay for mobile - shown when sidebar is open -->
  <div
    class="pointer-events-none fixed inset-0 z-10 bg-black/50 opacity-0 transition-opacity md:hidden"
    id="sidebar-overlay"
  >
  </div>

  <aside
    class="bg-sidebar pointer-events-none relative z-20 flex h-screen w-[15rem] -translate-x-full flex-col px-2 pt-2 text-white transition-transform duration-300 ease-in-out md:pointer-events-auto md:sticky md:top-0 md:flex md:translate-x-0"
    id="sidebar-panel"
  >
    <div class="mx-auto mt-5 mb-6 w-fit">
      <a href="/">
        <div class="m-auto block transition ease-in-out hover:scale-[102%]">
          <div class="h-[8.5rem] w-[8.5rem] overflow-hidden rounded-full">
            <Image
              class="h-full w-full object-cover"
              src={profileImage}
              alt="Portrait of Ricardo Torres"
              widths={[136, 272]}
              sizes="136px"
              formats={["avif", "webp"]}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </a>
    </div>

    <nav aria-label="Primary">
      <SidebarMenu sideBarActiveItemID={computedActiveId} />
    </nav>

    <div class="mt-auto px-0 pt-6">
      <SidebarFooter />
    </div>
  </aside>
</div>

<script is:inline>
  const overlay = document.getElementById("sidebar-overlay");
  const panel = document.getElementById("sidebar-panel");
  const sidebar = document.getElementById("sidebar");
  const headerEl = document.getElementById("site-header");
  const contentEl = document.getElementById("page-content");
  let previouslyFocused = null;

  function getFocusable(root) {
    if (!root) return [];
    const selectors = ["a[href]", "button", "textarea", "input", "select", '[tabindex]:not([tabindex="-1"])'].join(",");
    return Array.from(root.querySelectorAll(selectors)).filter(
      (el) => !el.hasAttribute("disabled") && !el.getAttribute("aria-hidden") && el.offsetParent !== null,
    );
  }

  function toggle() {
    // Re-query in case of soft navigations or DOM swaps
    const overlayEl = document.getElementById("sidebar-overlay");
    const panelEl = document.getElementById("sidebar-panel");
    const sidebarEl = document.getElementById("sidebar");
    const headerNow = document.getElementById("site-header");
    const contentNow = document.getElementById("page-content");
    if (!overlayEl || !panelEl || !sidebarEl) return;
    const isOpen = !panelEl.classList.contains("-translate-x-full");
    const nextOpen = !isOpen;

    if (nextOpen) {
      // Opening: slide in panel and fade in overlay
      panelEl.classList.remove("-translate-x-full", "pointer-events-none");
      overlayEl.classList.remove("opacity-0", "pointer-events-none");
      overlayEl.classList.add("opacity-100");
    } else {
      // Closing: slide out panel and fade out overlay
      panelEl.classList.add("-translate-x-full", "pointer-events-none");
      overlayEl.classList.add("opacity-0", "pointer-events-none");
      overlayEl.classList.remove("opacity-100");
    }

    // Ensure wrapper doesn't intercept taps when closed on mobile
    if (nextOpen) {
      sidebarEl.classList.remove("pointer-events-none");
    } else {
      sidebarEl.classList.add("pointer-events-none");
    }

    // Modal semantics only when open on mobile
    if (nextOpen) {
      previouslyFocused = document.activeElement;
      panelEl.setAttribute("role", "dialog");
      panelEl.setAttribute("aria-modal", "true");
      panelEl.setAttribute("aria-label", "Navigation");
      panelEl.removeAttribute("aria-hidden");
      // Move focus into panel
      const f = getFocusable(panelEl);
      f[0]?.focus();
      // Trap focus inside
      const trap = (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          toggle();
          return;
        }
        if (e.key !== "Tab") return;
        const focusables = getFocusable(panelEl);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      };
      panelEl.addEventListener("keydown", trap);
      panelEl._trapHandler = trap;
      // Inert background and prevent scroll
      headerNow?.setAttribute("inert", "");
      contentNow?.setAttribute("inert", "");
      document.body.style.overflow = "hidden";
    } else {
      panelEl.removeAttribute("role");
      panelEl.removeAttribute("aria-modal");
      panelEl.removeAttribute("aria-label");
      panelEl.setAttribute("aria-hidden", "true");
      if (panelEl._trapHandler) {
        panelEl.removeEventListener("keydown", panelEl._trapHandler);
        panelEl._trapHandler = null;
      }
      headerNow?.removeAttribute("inert");
      contentNow?.removeAttribute("inert");
      document.body.style.overflow = "";
      // Return focus to the toggle button if possible
      if (previouslyFocused && previouslyFocused.focus) {
        try {
          previouslyFocused.focus();
        } catch {}
      }
    }
    window.dispatchEvent(new CustomEvent("sidebarToggled", { detail: { open: nextOpen } }));
  }
  // Delegate overlay clicks to survive client navigations
  if (!window.__sidebarOverlayDelegated) {
    document.addEventListener("click", (e) => {
      const t = e.target;
      if (t && t.closest && t.closest("#sidebar-overlay")) {
        toggle();
      }
    });
    window.__sidebarOverlayDelegated = true;
  }
  if (!window.__sidebarToggleBound) {
    window.addEventListener("toggleSidebar", toggle);
    window.__sidebarToggleBound = true;
  }
</script>
