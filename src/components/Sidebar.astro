---
import { Picture } from "astro:assets";
import profileImage from "../images/profile.png";
import SidebarFooter from "./SidebarFooter.astro";
import SidebarMenu from "./SidebarMenu.astro";

// Determine active sidebar item from current path
const { pathname } = Astro.url;
const computedActiveId = pathname.startsWith("/posts") ? "posts" : pathname === "/" ? "home" : undefined;
---

<div class="pointer-events-none fixed inset-y-0 left-0 z-40 md:pointer-events-auto md:relative" id="sidebar">
  <!-- Hidden overlay for mobile - shown when sidebar is open -->
  <div
    class="pointer-events-none fixed inset-0 z-10 bg-black/50 opacity-0 transition-opacity md:hidden"
    id="sidebar-overlay"
  ></div>

  <aside
    class="bg-sidebar pointer-events-none relative z-20 flex h-screen w-[15rem] -translate-x-full flex-col px-2 pt-2 text-white transition-[translate,visibility] duration-300 ease-in-out max-md:invisible md:pointer-events-auto md:sticky md:top-0 md:flex md:translate-x-0"
    id="sidebar-panel"
  >
    <div class="mx-auto mt-5 mb-6 w-fit">
      <a href="/">
        <div class="m-auto block transition ease-in-out hover:scale-[102%]">
          <div class="h-[8.5rem] w-[8.5rem] overflow-hidden rounded-full">
            <Picture
              class="h-full w-full object-cover"
              src={profileImage}
              alt="Portrait of Ricardo Torres"
              widths={[136, 272]}
              sizes="136px"
              formats={["avif", "webp"]}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </a>
    </div>

    <nav aria-label="Primary">
      <SidebarMenu sideBarActiveItemID={computedActiveId} />
    </nav>

    <div class="mt-auto px-0 pt-6">
      <SidebarFooter />
    </div>
  </aside>
</div>

<script is:inline>
  (function () {
    if (window.__sidebarInitialized) return;
    window.__sidebarInitialized = true;
    let previouslyFocused = null;

    function getFocusable(root) {
      const selectors = ["a[href]", "button", "textarea", "input", "select", '[tabindex]:not([tabindex="-1"])'].join(
        ",",
      );
      return Array.from(root.querySelectorAll(selectors)).filter(
        (el) => !el.hasAttribute("disabled") && el.offsetParent !== null,
      );
    }

    function trap(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        toggle();
        return;
      }
      if (e.key !== "Tab") return;
      const focusables = getFocusable(e.currentTarget);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    // Elements are re-queried on every toggle because client navigations swap the body.
    function toggle() {
      const overlay = document.getElementById("sidebar-overlay");
      const panel = document.getElementById("sidebar-panel");
      const sidebar = document.getElementById("sidebar");
      if (!overlay || !panel || !sidebar) return;
      const open = panel.classList.contains("-translate-x-full");

      // max-md:invisible keeps the closed panel out of the tab order and accessibility tree on mobile.
      // Visibility transitions only on close; on open it must flip at once so focus can move in.
      panel.classList.toggle("-translate-x-full", !open);
      panel.classList.toggle("max-md:invisible", !open);
      panel.classList.toggle("transition-[translate,visibility]", !open);
      panel.classList.toggle("transition-[translate]", open);
      panel.classList.toggle("pointer-events-none", !open);
      overlay.classList.toggle("opacity-0", !open);
      overlay.classList.toggle("pointer-events-none", !open);
      overlay.classList.toggle("opacity-100", open);
      sidebar.classList.toggle("pointer-events-none", !open);

      for (const id of ["site-header", "page-content"]) {
        document.getElementById(id)?.toggleAttribute("inert", open);
      }
      document.body.style.overflow = open ? "hidden" : "";

      if (open) {
        previouslyFocused = document.activeElement;
        panel.setAttribute("role", "dialog");
        panel.setAttribute("aria-modal", "true");
        panel.setAttribute("aria-label", "Navigation");
        panel.addEventListener("keydown", trap);
        getFocusable(panel)[0]?.focus();
      } else {
        panel.removeAttribute("role");
        panel.removeAttribute("aria-modal");
        panel.removeAttribute("aria-label");
        panel.removeEventListener("keydown", trap);
        previouslyFocused?.focus?.();
      }
      window.dispatchEvent(new CustomEvent("sidebarToggled", { detail: { open } }));
    }

    document.addEventListener("click", (e) => {
      if (e.target?.closest?.("#sidebar-overlay")) toggle();
    });
    window.addEventListener("toggleSidebar", toggle);
  })();
</script>
