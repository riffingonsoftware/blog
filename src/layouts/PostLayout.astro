---
import type { PostSchema } from "../content/posts/config";
import DefaultLayout from "./DefaultLayout.astro";
import Comments from "../components/Comments.astro";
import { Image } from "astro:assets";

export interface Props extends PostSchema {}

const {
  author,
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags,
} = Astro.props as Props;

function formatDate(val: string | Date | undefined): string {
  if (!val) return '';
  if (typeof val === 'string') {
    if (/^\d{4}\.\d{2}\.\d{2}$/.test(val)) return val;
    const d = new Date(val);
    if (isNaN(d.getTime())) return val;
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${yyyy}.${mm}.${dd}`;
  }
  const d = val as Date;
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${yyyy}.${mm}.${dd}`;
}

const displayPubDate = formatDate(pubDate);
const displayUpdatedDate = formatDate(updatedDate);
---

<DefaultLayout author={author} title={title} description={description} image={heroImage} pubDate={pubDate}>
  <main class="md:flex md:justify-center">
    <div class="w-full max-w-[750px]">
    <article class="prose prose-lg prose-img:mx-auto">
      {heroImage && (
        <Image
          height={250}
          width={500}
          fit="contain"
          format="webp"
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="max-w-full rounded-lg"
          transition:name={heroImage}
        />
      )}
      <h1 class="title my-2 text-4xl font-bold" transition:name={title}>
        {title}
      </h1>
      {displayPubDate && <time>{displayPubDate}</time>}
      {displayUpdatedDate && (
        <div>
          Last updated on <time>{displayUpdatedDate}</time>
        </div>
      )}
      <div class="divider my-4"></div>
      <slot />
    </article>

    {tags && (
      <div class="mt-8 flex flex-wrap items-center gap-1 not-prose">
        <span class="mr-2">Tags:</span>
        {tags.map((tag) => (
          <a href={`/posts/${tag}/1`} class="badge badge-outline mt-1 bg-transparent border-gray-500 text-gray-300 hover:bg-white/10 hover:text-white">
            {tag}
          </a>
        ))}
      </div>
    )}

    <div class="mt-8 not-prose">
      <Comments />
    </div>
    </div>
  </main>
</DefaultLayout>
