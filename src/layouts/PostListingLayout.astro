---
import DefaultLayout from "./DefaultLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import type { CollectionEntry } from "astro:content";

type Page<T> = { data: T[]; url: { prev?: string; next?: string } };
export interface Props {
  page: Page<CollectionEntry<"posts">>;
  tag?: string;
  title: string;
}

const { page, tag, title } = Astro.props;
---

<DefaultLayout title={title}>
  {
    tag ? (
      <div>
        <div class="mt-10 mb-5 w-full text-3xl font-bold">Posts tagged "{tag}"</div>
      </div>
    ) : (
      <div>
        <div class="mt-10 mb-5 w-full text-3xl font-bold">All Posts</div>
      </div>
    )
  }

  <ul>
    {
      page.data.map((post) => (
        <li>
          <HorizontalCard
            pubDate={post.data.pubDate}
            title={post.data.title}
            img={post.data.heroImage}
            imgAlt={post.data.heroImageAlt}
            desc={post.data.description}
            url={"/posts/" + post.slug}
            tags={post.data.tags}
            target="_self"
          />
          <div class="divider my-0" />
        </li>
      ))
    }
  </ul>

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost mx-5 my-10">
          ← Recent posts
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost mx-5 my-10">
          Older posts →
        </a>
      ) : (
        <div />
      )
    }
  </div>
</DefaultLayout>
